#!/data/user/0/com.agyru.t2/files/usr/bin/bash
# agy-notify - Post and manage Android notifications.
set -e

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" 2>/dev/null && pwd)"
PREFIX="${PREFIX:-$(cd -- "$SCRIPT_DIR/.." 2>/dev/null && pwd)}"
RISH_BIN="$PREFIX/bin/rish"
HOME="${HOME:-$(cd -- "$PREFIX/.." 2>/dev/null && pwd)}"

# Язык интерфейса. Приложение пишет его в "$HOME/.agy_lang" (op setlang),
# поэтому уведомления в шторке говорят на том же языке, что и остальной UI.
# Приоритет: --lang/-L > $AGY_LANG > ~/.agy_lang > $LANG > ru.
agy_detect_lang() {
    local v="${1:-}"
    [ -n "$v" ] || v="${AGY_LANG:-}"
    [ -n "$v" ] || v="$(head -c 8 "$HOME/.agy_lang" 2>/dev/null || true)"
    [ -n "$v" ] || v="${LANG:-}"
    case "$v" in
        en*) printf '%s' "en" ;;
        ru*) printf '%s' "ru" ;;
        *)   printf '%s' "ru" ;;
    esac
}

# L "русский" "english" — строка под текущий язык уведомлений.
L() {
    if [ "$AGY_LANG" = "en" ]; then printf '%s' "$2"; else printf '%s' "$1"; fi
}

usage() {
    L 'Использование: agy-notify [post|cancel|list] [options]
Команды:
  post    -t <заголовок> [-s <подзаголовок>] [-m <сообщение>] [--tag <метка>]
  cancel  <метка>       Убрать уведомление с этой меткой
  list                  Показать активные уведомления
Общие опции:
  -L, --lang <ru|en>    Язык уведомления (по умолчанию из ~/.agy_lang)' \
'Usage: agy-notify [post|cancel|list] [options]
Commands:
  post    -t <title> [-s <subtitle>] [-m <message>] [--tag <tag>]
  cancel  <tag>         Remove the notification with this tag
  list    Show active notifications
Common options:
  -L, --lang <ru|en>    Notification language (default from ~/.agy_lang)'
}

CMD="${1:-post}"
shift || true

TITLE="Antigravity"
SUBTITLE=""
MESSAGE=""
TAG="agy_$(date +%s)"
LANG_OVERRIDE=""
# Pick up --lang before validation, so even argument errors use the right
# language. Iterates over a copy: the real "$@" is consumed by the parser below.
_scan=("$@")
_i=0
while [ "$_i" -lt "${#_scan[@]}" ]; do
    case "${_scan[$_i]}" in
        -L|--lang) LANG_OVERRIDE="${_scan[$((_i + 1))]:-}" ;;
    esac
    _i=$((_i + 1))
done
unset _scan _i
AGY_LANG="$(agy_detect_lang "$LANG_OVERRIDE")"
export AGY_LANG

if [ "$CMD" = "cancel" ]; then
    if [ "$#" -ne 1 ] || [ -z "$1" ]; then
        echo "agy-notify: $(L 'cancel требует ровно одну метку' 'cancel requires exactly one tag')" >&2
        usage >&2
        exit 2
    fi
    TAG="$1"
    set --
fi

# $1 — имя опции, для сообщения об ошибке.
missing_value() {
    echo "agy-notify: $(L "не указано значение для $1" "missing value for $1")" >&2
    exit 2
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -t|--title)
            [ "$#" -ge 2 ] || missing_value "$1"
            TITLE="$2"
            shift 2
            ;;
        -s|--subtitle)
            [ "$#" -ge 2 ] || missing_value "$1"
            SUBTITLE="$2"
            shift 2
            ;;
        -m|--message)
            [ "$#" -ge 2 ] || missing_value "$1"
            MESSAGE="$2"
            shift 2
            ;;
        --tag)
            [ "$#" -ge 2 ] || missing_value "$1"
            TAG="$2"
            shift 2
            ;;
        -L|--lang)
            [ "$#" -ge 2 ] || missing_value "$1"
            LANG_OVERRIDE="$2"
            shift 2
            ;;
        *)
            if [ -z "$MESSAGE" ]; then
                MESSAGE="$1"
            fi
            shift
            ;;
    esac
done

AGY_LANG="$(agy_detect_lang "$LANG_OVERRIDE")"
export AGY_LANG

if [ "$CMD" = "post" ]; then
    if [ -z "$MESSAGE" ] && [ -n "$TITLE" ]; then
        MESSAGE="$TITLE"
        TITLE="Antigravity"
    fi

    BODY_TEXT="$MESSAGE"
    if [ -n "$SUBTITLE" ]; then
        BODY_TEXT="[$SUBTITLE] $MESSAGE"
    fi

    if [ -x "$RISH_BIN" ]; then
        # Optional high-resolution logo cache with safe fallback to system default icon.
        LOGO_CACHE="/data/local/tmp/agy_logo.png"
        SRC_LOGO=""
        for candidate in "${AGY_LOGO:-}" "$PREFIX/share/antigravity/logo.png" "$PREFIX/share/pixmaps/antigravity.png"; do
            if [ -n "$candidate" ] && [ -f "$candidate" ]; then
                SRC_LOGO="$candidate"
                break
            fi
        done

        LARGE_ICON_OPT=""
        if [ -n "$SRC_LOGO" ]; then
            if ! "$RISH_BIN" -c "test -f $LOGO_CACHE" 2>/dev/null; then
                "$RISH_BIN" -c "cp -f $(printf %q "$SRC_LOGO") $(printf %q "$LOGO_CACHE") && chmod 644 $(printf %q "$LOGO_CACHE")" 2>/dev/null || true
            fi
            if "$RISH_BIN" -c "test -f $LOGO_CACHE" 2>/dev/null; then
                LARGE_ICON_OPT="-I file://$LOGO_CACHE"
            fi
        fi

        "$RISH_BIN" -c "cmd notification post -S bigtext $LARGE_ICON_OPT -t $(printf %q "$TITLE") $(printf %q "$TAG") $(printf %q "$BODY_TEXT")" 2>/dev/null && exit 0
    fi

    cmd notification post -S bigtext -t "$TITLE" "$TAG" "$BODY_TEXT" 2>/dev/null && exit 0 || true
    echo "[agy-notify] $(L 'уведомление поставлено в очередь' 'notification queued'): $TITLE - $MESSAGE"

elif [ "$CMD" = "cancel" ]; then
    if [ -x "$RISH_BIN" ]; then
        "$RISH_BIN" -c "cmd notification cancel $(printf %q "$TAG")" 2>/dev/null || true
    fi

elif [ "$CMD" = "list" ]; then
    if [ -x "$RISH_BIN" ]; then
        "$RISH_BIN" -c "dumpsys notification --noredact" 2>/dev/null | grep -E "pkg=|android.title=|android.text=" | head -n 40
    else
        echo "[agy-notify] $(L 'rish недоступен, шторка уведомлений недоступна' 'rish unavailable to inspect system notification tray')"
    fi

else
    usage
    exit 1
fi
